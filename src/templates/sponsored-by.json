{
  "id": "sponsored-by",
  "version": 1,
  "name": { "en": "Sponsored by", "zh": "由以下品牌赞助" },
  "canvas": { "ratios": ["1:1", "4:5", "16:9"], "basePx": 1080 },
  "constraints": { "maxColors": 8, "allowGradient": false, "allowAlpha": false },
  "palette": { "bg": "#0a0a0a", "fg": "#ffffff", "accent": "#ffd400" },
  "layers": [
    {
      "type": "text",
      "id": "title",
      "default": { "en": "SPONSORED BY", "zh": "由以下品牌赞助" },
      "font": "display",
      "fit": "auto-shrink",
      "box": [0.08, 0.1, 0.84, 0.22],
      "align": "center"
    },
    {
      "type": "ticker",
      "id": "rows",
      "rows": 3,
      "box": [0, 0.38, 1, 0.52],
      "iconScale": 0.62,
      "gap": 0.6,
      "phaseJitter": 0.37,
      "speedJitter": 0.18,
      "items": [
        { "icon": "emoji:💸", "phase": 0, "speed": 1 },
        { "icon": "emoji:🚀", "phase": 0.33, "speed": 1 },
        { "icon": "emoji:🫡", "phase": 0.66, "speed": 1 }
      ]
    }
  ],
  "variants": [
    {
      "id": "made-possible",
      "name": { "en": "Made possible by", "zh": "特别感谢" },
      "patch": [
        {
          "op": "replace",
          "path": "/layers/0/default",
          "value": { "en": "MADE POSSIBLE BY", "zh": "特别感谢" }
        }
      ]
    },
    {
      "id": "inverted",
      "name": { "en": "Inverted (light card)", "zh": "反色（浅色卡）" },
      "patch": [
        {
          "op": "replace",
          "path": "/palette",
          "value": { "bg": "#f5f3ee", "fg": "#111111", "accent": "#b45309" }
        }
      ]
    }
  ],
  "animation": { "loopSeconds": "auto", "fps": 16, "loop": true },
  "export": { "formats": ["gif", "png", "svg", "mp4"], "gifMaxColors": 32, "dither": "atkinson" }
}
